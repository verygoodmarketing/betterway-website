---
import { COMPANY, GUARANTEE, telHref } from '../config/company'

interface Props {
	heading?: string
	sub?: string
	location?: string
}

const {
	heading = 'Still seeing them? Let us take a look.',
	sub = 'Free inspection, a real quote before any work starts, and a guarantee behind it.',
	location = 'cta-band',
} = Astro.props as Props
---

<section class="section section-dark on-dark cta-band">
	<div class="container cta-inner">
		<div class="cta-copy">
			<h2>{heading}</h2>
			<p class="muted cta-sub">{sub}</p>
		</div>
		<div class="cta-actions">
			<a href={telHref()} data-location={location} class="btn btn-cta btn-lg">
				Call {COMPANY.phoneFormatted}
			</a>
			<a href="/request-inspection" class="btn btn-outline btn-lg">Request Free Inspection</a>
			<p class="cta-note">{GUARANTEE.name} · Mon–Sat 7am–6pm</p>
		</div>
	</div>
</section>

<style>
	.cta-inner {
		display: grid;
		gap: 1.5rem;
		align-items: center;
	}
	.cta-copy { display: grid; gap: 0.625rem; }
	.cta-sub { font-size: var(--text-lg); max-width: 44ch; }
	.cta-actions { display: grid; gap: 0.75rem; }
	.cta-note {
		font-size: var(--text-xs);
		color: rgb(255 255 255 / 0.75);
		text-align: center;
	}

	@media (min-width: 880px) {
		.cta-inner { grid-template-columns: 1.2fr 1fr; gap: 3rem; }
		.cta-actions { align-content: center; }
	}
</style>

---
import Icon from './Icon.astro'

interface Props {
	title: string
	description?: string
	icon?: string
}
const { title, description, icon = 'check' } = Astro.props as Props
---

<div class="text-center space-y-2 trust-badge">
	<div class="flex items-center justify-center mb-2 text-[color:var(--primary)]">
		<Icon name={icon} class="w-8 h-8" />
	</div>
	<h3 class="text-sm font-bold">{title}</h3>
	{description && <p class="text-xs text-muted-foreground">{description}</p>}
</div>

---
import {
	COMPANY,
	SERVICES,
	SERVICE_AREAS,
	GUARANTEE,
	telHref,
	addressLines,
	areaPath,
	servicePath,
} from '../config/company'
import Icon from './Icon.astro'
import FacebookMark from './FacebookMark.astro'
import YelpMark from './YelpMark.astro'
import GoogleMark from './GoogleMark.astro'

const [street, cityLine] = addressLines()
const social = Object.entries(COMPANY.social).filter(([, url]) => url)
const year = new Date().getFullYear()

const socialLabels: Record<string, string> = {
	facebook: 'Facebook',
	yelp: 'Yelp',
	google: 'Google',
}
---

<footer class="site-footer on-dark">
	<div class="container">
		{/* One more call CTA before the link columns — the footer is where people
		    land after reading, and scrolling back up is friction. */}
		<div class="footer-cta">
			<p class="footer-cta-text">Ready when you are.</p>
			<a href={telHref()} data-location="footer-cta" class="btn btn-cta btn-lg">
				Call {COMPANY.phoneFormatted}
			</a>
		</div>

		<div class="footer-grid">
			<section class="footer-col footer-contact">
				<h2 class="footer-h">Contact</h2>

				<div class="footer-contact-block">
					<span class="footer-contact-icon"><Icon name="map-pin" size={18} /></span>
					<address class="footer-address">
						{street}<br />{cityLine}
					</address>
				</div>

				<div class="footer-contact-block">
					<span class="footer-contact-icon"><Icon name="phone" size={18} /></span>
					<a href={telHref()} data-location="footer" class="footer-phone">{COMPANY.phoneFormatted}</a>
				</div>

				<div class="footer-contact-block">
					<span class="footer-contact-icon"><Icon name="clock" size={18} /></span>
					<ul class="footer-hours">
						{COMPANY.hoursDisplay.map(row => (
							<li>
								<span class="footer-hours-days">{row.days}</span>
								<span class="footer-hours-sep" aria-hidden="true">·</span>
								<span class="muted">{row.hours}</span>
							</li>
						))}
					</ul>
				</div>

				{social.length > 0 && (
					<nav class="footer-social" aria-label="Social media">
						<ul>
							{social.map(([key, url]) => {
								const name = socialLabels[key] ?? key
								return (
									<li>
										<a href={url} rel="noopener noreferrer" target="_blank">
											<span class="footer-social-mark">
												{key === 'facebook' && <FacebookMark />}
												{key === 'yelp' && <YelpMark />}
												{key === 'google' && <GoogleMark />}
											</span>
											<span class="sr-only">{name} (opens in a new tab)</span>
										</a>
									</li>
								)
							})}
						</ul>
					</nav>
				)}
			</section>

			<section class="footer-col">
				<h2 class="footer-h">Services</h2>
				<ul class="footer-links">
					{SERVICES.map(service => (
						<li><a href={servicePath(service.slug)}>{service.name}</a></li>
					))}
				</ul>
			</section>

			<section class="footer-col">
				<h2 class="footer-h">Service Areas</h2>
				<ul class="footer-links">
					{SERVICE_AREAS.map(area => (
						<li><a href={areaPath(area.slug)}>Pest Control {area.name}, AL</a></li>
					))}
				</ul>
			</section>

			<section class="footer-col">
				<h2 class="footer-h">Company</h2>
				<ul class="footer-links">
					<li><a href="/about">About Us</a></li>
					<li><a href="/testimonials">Reviews</a></li>
					<li><a href="/review">Leave a Google Review</a></li>
					<li><a href="/guarantee">{GUARANTEE.name}</a></li>
					<li><a href="/request-inspection">Request an Inspection</a></li>
				</ul>
			</section>
		</div>

		<div class="footer-bottom">
			<p>© {year} {COMPANY.name}. All rights reserved.</p>
			<p class="muted">Serving {COMPANY.address.locality} and North Alabama.</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-brand-900);
		color: #fff;
		padding-block: clamp(2rem, 5vw, 3rem) 1.5rem;
		margin-top: 0;
	}
	.footer-cta {
		display: grid;
		gap: 0.875rem;
		justify-items: center;
		text-align: center;
		padding-bottom: 2rem;
		margin-bottom: 2rem;
		border-bottom: 1px solid rgb(255 255 255 / 0.15);
	}
	.footer-cta-text { font-size: var(--text-xl); font-weight: 800; }

	.footer-grid { display: grid; gap: 2rem; }
	.footer-col { display: grid; gap: 0.75rem; align-content: start; }
	.footer-h {
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent-300);
	}

	.footer-contact { gap: 1rem; }
	.footer-contact-block {
		display: grid;
		grid-template-columns: 1.125rem 1fr;
		gap: 0.75rem;
		align-items: start;
	}
	.footer-contact-icon {
		display: flex;
		color: var(--color-accent-300);
		margin-top: 0.2rem;
	}
	.footer-address {
		font-style: normal;
		font-size: var(--text-sm);
		line-height: 1.45;
	}
	.footer-phone {
		font-size: var(--text-lg);
		font-weight: 800;
		text-decoration: none;
		line-height: 1.2;
		width: fit-content;
	}
	.footer-hours {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.2rem;
		width: max-content;
		font-size: var(--text-sm);
		line-height: 1.45;
		font-variant-numeric: tabular-nums;
	}
	.footer-hours li {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}
	.footer-hours-days { font-weight: 600; }
	.footer-hours-sep { opacity: 0.45; }

	.footer-social { padding-left: calc(1.125rem + 0.75rem); }
	.footer-social ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
	}
	.footer-social a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--tap);
		height: var(--tap);
		border-radius: 999px;
		background: rgb(255 255 255 / 0.08);
		text-decoration: none;
	}
	.footer-social a:hover {
		background: rgb(255 255 255 / 0.16);
	}
	.footer-social a:focus-visible {
		outline-color: var(--color-accent-300);
	}
	.footer-social-mark {
		display: flex;
		width: 22px;
		height: 22px;
		flex-shrink: 0;
	}
	.footer-social-mark :global(svg) {
		width: 22px;
		height: 22px;
	}

	.footer-links { list-style: none; margin: 0; padding: 0; display: grid; }
	.footer-links a {
		display: flex;
		align-items: center;
		min-height: 40px;
		font-size: var(--text-sm);
		text-decoration: none;
	}
	.footer-links a:hover, .footer-phone:hover { color: var(--color-accent-300); }

	.footer-bottom {
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgb(255 255 255 / 0.15);
		display: grid;
		gap: 0.25rem;
		font-size: var(--text-xs);
	}

	@media (min-width: 640px) {
		.footer-grid { grid-template-columns: repeat(2, 1fr); }
		.footer-cta { grid-template-columns: auto auto; justify-content: center; align-items: center; gap: 1.5rem; }
	}
	@media (min-width: 1024px) {
		.footer-grid { grid-template-columns: 1.3fr 1fr 1fr 1fr; gap: 2.5rem; }
		.footer-bottom { grid-template-columns: 1fr auto; }
	}
</style>

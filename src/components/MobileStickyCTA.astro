---
import { COMPANY, telHref } from '../config/company'
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80 md:hidden">
	<div class="container py-3 grid grid-cols-2 gap-3">
		<a href={telHref()} data-location="mobile-sticky" class="btn btn-primary w-full"
			>Call {COMPANY.phoneFormatted}</a
		>
		<a href="/request-inspection" class="btn btn-outline w-full">Free Inspection</a>
	</div>
</div>

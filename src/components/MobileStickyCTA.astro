---
import { COMPANY, telHref } from '../config/company'
---

{/*
  Call-first: the phone button takes two-thirds of the bar and carries the amber
  CTA colour; the form is the secondary, quieter option. This is the only
  element on the site pinned to the viewport, so it stays cheap — no JS, and it
  respects the iOS home-indicator inset so the buttons are never half-tappable.
*/}
<div class="sticky-cta" role="complementary" aria-label="Contact Better Way Pest Control">
	<div class="sticky-inner">
		<a href={telHref()} data-location="mobile-sticky" class="btn btn-cta sticky-call">
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>
			</svg>
			<span>Call {COMPANY.phoneFormatted}</span>
		</a>
		<a href="/request-inspection" class="btn btn-outline sticky-form">Free<br />Inspection</a>
	</div>
</div>

<style>
	.sticky-cta {
		position: fixed;
		inset-inline: 0;
		bottom: 0;
		z-index: 40;
		background: #fff;
		border-top: 1px solid var(--color-line);
		box-shadow: 0 -4px 16px rgb(0 0 0 / 0.08);
		padding-bottom: env(safe-area-inset-bottom, 0);
	}
	.sticky-inner {
		display: grid;
		grid-template-columns: 1.75fr 1fr;
		gap: 0.5rem;
		padding: 0.625rem 1rem;
		max-width: 34rem;
		margin-inline: auto;
	}
	/* The number must sit on one line — a wrapped phone number reads as broken
	   and pushes the bar taller than the space main reserves for it. */
	.sticky-call {
		font-size: var(--text-sm);
		white-space: nowrap;
		padding-inline: 0.5rem;
	}
	.sticky-form {
		font-size: var(--text-xs);
		line-height: 1.15;
		padding-inline: 0.5rem;
	}

	@media (min-width: 900px) {
		.sticky-cta { display: none; }
	}
</style>

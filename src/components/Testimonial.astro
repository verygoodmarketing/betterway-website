---
interface Props {
	quote: string
	author: string
	location?: string
	rating?: number
}
const { quote, author, location, rating = 5 } = Astro.props as Props
---

<figure class="review">
	<div class="stars" role="img" aria-label={`${rating} out of 5 stars`}>
		{Array.from({ length: 5 }).map((_, i) => (
			<svg viewBox="0 0 20 20" width="18" height="18" fill={i < rating ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.5" aria-hidden="true">
				<path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.3a1 1 0 0 0 .95.68h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.04a1 1 0 0 0-.37 1.11l1.07 3.3c.3.92-.75 1.68-1.54 1.11l-2.8-2.03a1 1 0 0 0-1.17 0l-2.8 2.03c-.79.57-1.84-.19-1.54-1.11l1.07-3.3a1 1 0 0 0-.37-1.11l-2.8-2.04c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 0 0 .95-.69l1.07-3.29z" />
			</svg>
		))}
	</div>
	<blockquote class="review-quote">{quote}</blockquote>
	<figcaption class="review-by">
		{author}{location && <span class="muted">, {location}</span>}
	</figcaption>
</figure>

<style>
	.review {
		display: grid;
		align-content: start;
		gap: 0.75rem;
		margin: 0;
		padding: 1.5rem;
		background: #fff;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-card);
		height: 100%;
	}
	.stars { display: flex; gap: 2px; color: var(--color-accent-600); }
	.review-quote {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.6;
	}
	.review-quote::before { content: '“'; }
	.review-quote::after { content: '”'; }
	.review-by { font-size: var(--text-sm); font-weight: 700; }
</style>

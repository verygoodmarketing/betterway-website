---
interface Props { 
  quote: string
  author: string
  location?: string
  rating?: number
}
const { quote, author, location, rating = 5 } = Astro.props as Props
---

<figure class="rounded-xl border-2 border-[color:var(--border)] p-6 bg-white shadow-sm">
	<div class="flex gap-1 mb-3">
		{Array.from({ length: 5 }).map((_, i) => (
			<svg class={`w-5 h-5 ${i < rating ? 'text-yellow-400 fill-yellow-400' : 'text-gray-300'}`} viewBox="0 0 20 20" fill="currentColor">
				<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
			</svg>
		))}
	</div>
	<blockquote class="text-lg italic">"{quote}"</blockquote>
	<figcaption class="mt-4 text-sm font-medium">
		— {author}{location && <span class="text-muted-foreground">, {location}</span>}
	</figcaption>
</figure>



---
const action = '/api/request-inspection'
---

<form
	id="request-inspection"
	action={action}
	method="post"
	class="rounded-xl border p-4 md:p-6 space-y-3 bg-white/80"
	autocomplete="on"
	novalidate
>
	<div class="grid gap-3">
		<label
			class="text-sm font-medium"
			for="email"
			>Email address</label
		>
		<input
			id="email"
			name="email"
			type="email"
			required
			autocomplete="email"
			aria-describedby="email-help"
			class="w-full rounded-md border px-3 py-2"
			placeholder="you@example.com"
		/>
	</div>
	<div class="grid gap-3">
		<label
			class="text-sm font-medium"
			for="name"
			>Contact Name</label
		>
		<input
			id="name"
			name="name"
			type="text"
			required
			autocomplete="name"
			class="w-full rounded-md border px-3 py-2"
			placeholder="First and last name"
		/>
	</div>
	<div class="grid gap-3">
		<label
			class="text-sm font-medium"
			for="zip"
			>Service Zipcode</label
		>
		<input
			id="zip"
			name="zip"
			inputmode="numeric"
			pattern="\\d{5}"
			required
			autocomplete="postal-code"
			class="w-full rounded-md border px-3 py-2"
			placeholder="35640"
		/>
	</div>
	<div class="grid gap-3">
		<label
			class="text-sm font-medium"
			for="phone"
			>Phone</label
		>
		<input
			id="phone"
			name="phone"
			type="tel"
			inputmode="tel"
			required
			autocomplete="tel"
			class="w-full rounded-md border px-3 py-2"
			placeholder="(256) 555-1234"
		/>
	</div>
	<input
		type="text"
		name="company"
		class="hidden"
		tabindex="-1"
		autocomplete="off"
		aria-hidden="true"
	/>
	<div class="flex gap-3">
		<button
			type="submit"
			class="btn btn-primary w-full"
			>Get Started</button
		>
	</div>
	<p
		id="email-help"
		class="text-xs text-muted-foreground"
	>
		We’ll never share your email with anyone else.
	</p>
	<div
		id="form-status"
		class="text-sm"
		aria-live="polite"
	>
	</div>
</form>

<script>
	const el = document.currentScript?.previousElementSibling as Element | null
	if (el instanceof HTMLFormElement) {
		const form = el
		form.addEventListener('submit', async e => {
			e.preventDefault()
			const status = form.querySelector<HTMLDivElement>('#form-status')
			if (status) status.textContent = 'Submitting...'
			const formData = new FormData(form)
			try {
				const res = await fetch(form.action, { method: 'POST', body: formData })
				if (res.ok) {
					if (status) status.textContent = 'Thanks! We will contact you shortly.'
					form.reset()
				} else {
					if (status) status.textContent = 'There was a problem. Please call (256) 580-6181 or try again.'
				}
			} catch (_) {
				if (status) status.textContent = 'Network error. Please call (256) 580-6181.'
			}
		})
	}
</script>

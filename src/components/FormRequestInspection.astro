---
import { COMPANY, SERVICES, LEAD_FORM_ENABLED } from '../config/company'

interface Props {
	/** Preselects the service dropdown, e.g. from a service page. */
	defaultService?: string
	/** Unique per instance — multiple forms can appear on one page. */
	id?: string
}

const { defaultService = '', id = 'lead-form' } = Astro.props as Props
const statusId = `${id}-status`
---

{
	/*
	 * Renders nothing when the lead form is switched off in company.ts, so the
	 * site can ship call-only without editing every page that embeds a form.
	 */
}
{LEAD_FORM_ENABLED && (
	<form
		id={id}
		action="/api/request-inspection"
		method="post"
		class="rounded-xl border p-4 md:p-6 space-y-3 bg-white/80"
		autocomplete="on"
		data-lead-form
		data-phone={COMPANY.phoneFormatted}
		novalidate
	>
		<div class="grid gap-1.5">
			<label class="text-sm font-medium" for={`${id}-name`}>Contact Name</label>
			<input
				id={`${id}-name`}
				name="name"
				type="text"
				required
				autocomplete="name"
				class="w-full rounded-md border px-3 py-2"
				placeholder="First and last name"
			/>
		</div>

		<div class="grid gap-1.5">
			<label class="text-sm font-medium" for={`${id}-phone`}>Phone</label>
			<input
				id={`${id}-phone`}
				name="phone"
				type="tel"
				inputmode="tel"
				required
				autocomplete="tel"
				class="w-full rounded-md border px-3 py-2"
				placeholder="(256) 555-1234"
			/>
		</div>

		<div class="grid gap-1.5">
			<label class="text-sm font-medium" for={`${id}-email`}>Email address</label>
			<input
				id={`${id}-email`}
				name="email"
				type="email"
				required
				autocomplete="email"
				aria-describedby={`${id}-email-help`}
				class="w-full rounded-md border px-3 py-2"
				placeholder="you@example.com"
			/>
		</div>

		<div class="grid gap-1.5">
			<label class="text-sm font-medium" for={`${id}-zip`}>Service Zipcode</label>
			<input
				id={`${id}-zip`}
				name="zip"
				inputmode="numeric"
				pattern="[0-9]{5}"
				required
				autocomplete="postal-code"
				class="w-full rounded-md border px-3 py-2"
				placeholder="35640"
			/>
		</div>

		<div class="grid gap-1.5">
			<label class="text-sm font-medium" for={`${id}-service`}>What do you need?</label>
			<select id={`${id}-service`} name="service" class="w-full rounded-md border px-3 py-2 bg-white">
				<option value="">Not sure yet</option>
				{SERVICES.map(service => (
					<option value={service.slug} selected={service.slug === defaultService}>
						{service.name}
					</option>
				))}
			</select>
		</div>

		{/* Honeypot. Bots fill it, humans never see it. */}
		<input
			type="text"
			name="company"
			class="hidden"
			tabindex="-1"
			autocomplete="off"
			aria-hidden="true"
		/>

		<button type="submit" class="btn btn-primary w-full">Request Free Inspection</button>

		<p id={`${id}-email-help`} class="text-xs text-muted-foreground">
			We'll never share your email with anyone else.
		</p>

		<div id={statusId} class="text-sm" aria-live="polite"></div>
	</form>
)}

<script>
	// Binds every lead form on the page. `document.currentScript` is null in an
	// Astro module script, so the previous-sibling trick does not work here —
	// query for the forms instead, and guard so a second instance of this
	// component does not double-bind the same form.
	function trackEvent(name: string, params: Record<string, unknown> = {}) {
		const w = window as any
		if (typeof w.gtag === 'function') w.gtag('event', name, params)
	}

	document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach(form => {
		if (form.dataset.initialized === 'true') return
		form.dataset.initialized = 'true'

		const phone = form.dataset.phone ?? ''
		const status = form.querySelector<HTMLDivElement>('[aria-live="polite"]')
		const setStatus = (msg: string) => {
			if (status) status.textContent = msg
		}

		form.addEventListener(
			'focusin',
			() => {
				if (form.dataset.started === 'true') return
				form.dataset.started = 'true'
				trackEvent('lead_form_start')
			},
			{ once: true },
		)

		form.addEventListener('submit', async e => {
			e.preventDefault()

			if (!form.checkValidity()) {
				form.reportValidity()
				return
			}

			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')
			if (button) button.disabled = true
			setStatus('Submitting…')
			trackEvent('lead_form_submit_attempt')

			try {
				const res = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
				})
				if (res.ok) {
					setStatus('Thanks! We will contact you shortly.')
					form.reset()
					trackEvent('generate_lead')
				} else {
					setStatus(`There was a problem. Please call ${phone} or try again.`)
					trackEvent('lead_form_error', { status: res.status })
				}
			} catch {
				setStatus(`Network error. Please call ${phone}.`)
				trackEvent('lead_form_error', { status: 'network' })
			} finally {
				if (button) button.disabled = false
			}
		})
	})
</script>

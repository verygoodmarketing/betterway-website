---
import Icon from './Icon.astro'
import GoogleMark from './GoogleMark.astro'
import { DIFFERENTIATORS } from '../config/company'
import { googleReviews } from '../config/reviews'

const ratingLabel = googleReviews.rating.toFixed(1)
---

{/* Sits directly under the hero. Proof immediately after the first CTA is what
    makes the CTA credible rather than pushy. */}
<div class="trust-bar">
	<div class="container">
		<div class="trust-grid">
			<a href="/testimonials" class="trust-item trust-google">
				<span class="trust-icon"><GoogleMark class="trust-gmark" /></span>
				<span class="trust-label">{ratingLabel} on Google · {googleReviews.reviewCount} reviews</span>
			</a>
			{DIFFERENTIATORS.map(item => (
				<div class="trust-item">
					<span class="trust-icon"><Icon name={item.icon} class="icon-sm" /></span>
					<span class="trust-label">{item.title}</span>
				</div>
			))}
		</div>
	</div>
</div>

<style>
	.trust-bar {
		background: var(--color-brand-800);
		color: #fff;
		padding-block: 0.875rem;
	}
	.trust-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem 1.25rem;
		align-items: center;
		justify-items: start;
	}
	.trust-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		text-decoration: none;
		color: inherit;
	}
	.trust-google:hover .trust-label { text-decoration: underline; }
	.trust-icon {
		color: var(--color-accent-400);
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
	}
	.trust-gmark { width: 18px; height: 18px; }
	.trust-label {
		font-size: var(--text-xs);
		font-weight: 700;
		line-height: 1.25;
		text-wrap: balance;
	}
	@media (min-width: 1024px) {
		.trust-bar { padding-block: 1rem; }
		.trust-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 1.5rem;
			justify-items: center;
		}
		.trust-label { font-size: var(--text-sm); }
	}
</style>

---
interface Props {
	faqs: { q: string; a: string }[]
	heading?: string
}

const { faqs, heading = 'Common Questions' } = Astro.props as Props
---

{faqs.length > 0 && (
	<section class="container py-12">
		<div class="max-w-3xl">
			<h2 class="mb-6">{heading}</h2>
			<div class="divide-y border-t border-b">
				{faqs.map(faq => (
					<details class="group py-4">
						<summary class="cursor-pointer font-semibold list-none flex items-start justify-between gap-4">
							<span>{faq.q}</span>
							<span class="text-[color:var(--primary)] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
						</summary>
						<p class="mt-3 text-muted-foreground">{faq.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>
)}

---
import { getIcon } from '../lib/icons'

interface Props {
	name: string
	class?: string
	size?: number
}

const { name, class: className = 'icon-md', size = 24 } = Astro.props as Props
const path = getIcon(name)
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={path}
/>

<style is:global>
	.icon-sm { width: 18px; height: 18px; }
	.icon-md { width: 24px; height: 24px; }
	.icon-lg { width: 32px; height: 32px; }
</style>

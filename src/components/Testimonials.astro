---
import { getCollection } from 'astro:content'
import Testimonial from './Testimonial.astro'

interface Props {
	featuredOnly?: boolean
	heading?: string
	sub?: string
	limit?: number
	alt?: boolean
}

const {
	featuredOnly = false,
	heading = 'What our customers say',
	sub,
	limit,
	alt = true,
} = Astro.props as Props

const all = await getCollection('testimonials')
const filtered = featuredOnly ? all.filter(t => t.data.featured) : all
const reviews = limit ? filtered.slice(0, limit) : filtered
---

{/* No reviews on file → the whole section hides rather than rendering an empty grid. */}
{reviews.length > 0 && (
	<section class={`section${alt ? ' section-alt' : ''}`}>
		<div class="container reviews-wrap">
			<div class="reviews-head">
				<h2>{heading}</h2>
				{sub && <p class="muted">{sub}</p>}
			</div>
			<div class="reviews-grid">
				{reviews.map(review => (
					<Testimonial
						quote={review.data.text}
						author={review.data.name}
						location={review.data.location}
						rating={review.data.rating ?? 5}
					/>
				))}
			</div>
		</div>
	</section>
)}

<style>
	.reviews-wrap { display: grid; gap: 1.75rem; }
	.reviews-head { display: grid; gap: 0.5rem; }
	.reviews-grid { display: grid; gap: 1rem; }
	@media (min-width: 640px) { .reviews-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (min-width: 1024px) { .reviews-grid { grid-template-columns: repeat(3, 1fr); } }
</style>

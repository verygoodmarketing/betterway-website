---
interface Props {
	number: number
	title: string
	description: string
}
const { number, title, description } = Astro.props as Props
---

<div class="step">
	<span class="step-num" aria-hidden="true">{number}</span>
	<div class="step-body">
		<h3 class="step-title">{title}</h3>
		<p class="muted step-desc">{description}</p>
	</div>
</div>

<style>
	.step { display: flex; gap: 1rem; align-items: flex-start; }
	.step-num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		background: var(--color-brand-800);
		color: #fff;
		font-weight: 800;
	}
	.step-body { display: grid; gap: 0.25rem; }
	.step-title { font-size: var(--text-lg); }
	.step-desc { font-size: var(--text-sm); line-height: 1.6; }
</style>

---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import MobileStickyCTA from '../components/MobileStickyCTA.astro'
import { COMPANY, GA_ID } from '../config/company'
import { localBusinessSchema } from '../lib/schema'

interface Props {
	content: {
		title: string
		description?: string
		noindex?: boolean
		/** Site-root path or absolute URL. Defaults to COMPANY.og.image. */
		ogImage?: string
		ogImageAlt?: string
		ogImageWidth?: number
		ogImageHeight?: number
		ogImageType?: string
	}
	/** Extra JSON-LD blocks for this page (Service, FAQPage, BreadcrumbList). */
	schemas?: unknown[]
}

const { content, schemas = [] } = Astro.props as Props

// Canonical with the trailing slash stripped, so /about and /about/ do not
// generate a duplicate-content pair.
const canonical = new URL(
	Astro.url.pathname.replace(/\/+$/, '') || '/',
	COMPANY.url,
).toString()

const description =
	content.description ??
	`${COMPANY.name} serves North Alabama with reliable, affordable pest control for homes and businesses. Call ${COMPANY.phoneFormatted}.`

const ogImage = new URL(content.ogImage ?? COMPANY.og.image, COMPANY.url).toString()
const ogImageAlt = content.ogImageAlt ?? COMPANY.og.alt
const ogImageWidth = content.ogImageWidth ?? COMPANY.og.width
const ogImageHeight = content.ogImageHeight ?? COMPANY.og.height
const ogImageType = content.ogImageType ?? COMPANY.og.type

const allSchemas = [localBusinessSchema(), ...schemas].filter(Boolean)
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#14532d" />

		<title>{content.title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{content.noindex && <meta name="robots" content="noindex, follow" />}

		<link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/img/favicon/favicon-16x16.png" />
		<link rel="manifest" href="/img/favicon/site.webmanifest" />
		<link rel="mask-icon" href="/img/favicon/safari-pinned-tab.svg" color="#008900" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<meta name="msapplication-TileColor" content="#da532c" />
		<meta name="msapplication-config" content="/img/favicon/browserconfig.xml" />

		<meta property="og:title" content={content.title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={COMPANY.name} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		{allSchemas.map(schema => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}

		{/*
		  Analytics is the only third-party request on the site, and it only loads
		  when an ID is actually configured. No web fonts, no tag manager, no chat
		  widget — that absence is most of the mobile performance story.
		*/}
		{GA_ID && (
			<>
				<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
				<script is:inline define:vars={{ GA_ID }}>
					window.dataLayer = window.dataLayer || []
					function gtag() {
						dataLayer.push(arguments)
					}
					gtag('js', new Date())
					gtag('config', GA_ID)
				</script>
			</>
		)}
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<MobileStickyCTA />

		<script is:inline>
			// Global click tracking. Lives here rather than on each link so a new
			// CTA anywhere on the site is tracked without extra wiring.
			;(function () {
				function track(event, params) {
					if (window.gtag) window.gtag('event', event, params || {})
				}
				document.addEventListener('click', function (e) {
					var t = e.target
					if (!t || !t.closest) return
					var tel = t.closest('a[href^="tel:"]')
					if (tel) {
						track('phone_call_click', {
							link_text: (tel.textContent || '').trim(),
							location: tel.dataset.location || 'unknown',
						})
					}
					var el = t.closest('[data-analytics]')
					if (el) track(el.dataset.analytics, {})
				})
				document.addEventListener(
					'toggle',
					function (e) {
						if (e.target.tagName === 'DETAILS' && e.target.open) {
							var s = e.target.querySelector('summary')
							track('faq_expand', { question: s ? s.textContent.trim() : '' })
						}
					},
					true,
				)
			})()
		</script>
	</body>
</html>

<style is:global>
	/* The sticky call bar overlays the end of the page on mobile; this reserves
	   room for it. The bar measures ~90px including the safe-area inset, so this
	   carries headroom — tests/e2e/conversion.spec.ts asserts the two agree. */
	main {
		padding-bottom: 104px;
	}
	@media (min-width: 900px) {
		main { padding-bottom: 0; }
	}

	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		z-index: 100;
		padding: 0.75rem 1rem;
		background: var(--color-brand-900);
		color: #fff;
		font-weight: 700;
	}
	.skip-link:focus {
		left: 0.5rem;
		top: 0.5rem;
	}
</style>

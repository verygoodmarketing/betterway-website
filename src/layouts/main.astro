---
import '../styles/global.css'
import MobileStickyCTA from '../components/MobileStickyCTA.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { COMPANY, GA_ID } from '../config/company'
import { localBusinessSchema } from '../lib/schema'

interface Props {
	content: {
		title: string
		description?: string
		noindex?: boolean
		ogImage?: string
	}
	/** Extra JSON-LD blocks for this page (Service, FAQPage, BreadcrumbList). */
	schemas?: unknown[]
}

const { content, schemas = [] } = Astro.props as Props

// Canonical with the trailing slash stripped, so /about and /about/ do not
// generate a duplicate-content pair.
const canonical = new URL(
	Astro.url.pathname.replace(/\/+$/, '') || '/',
	COMPANY.url,
).toString()

const description =
	content.description ??
	`${COMPANY.name} serves North Alabama with reliable, affordable pest control for homes and businesses. Call ${COMPANY.phoneFormatted}.`

const ogImage = new URL(content.ogImage ?? COMPANY.logo, COMPANY.url).toString()

const allSchemas = [localBusinessSchema(), ...schemas].filter(Boolean)
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
		<link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
		<meta name="theme-color" content="#0a7a7a" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<title>{content.title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{content.noindex && <meta name="robots" content="noindex, follow" />}

		<meta property="og:title" content={content.title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={COMPANY.name} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={content.title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{allSchemas.map(schema => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}

		{GA_ID && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
				<script is:inline define:vars={{ GA_ID }}>
					window.dataLayer = window.dataLayer || []
					function gtag() {
						dataLayer.push(arguments)
					}
					gtag('js', new Date())
					gtag('config', GA_ID)
				</script>
			</>
		)}
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 btn btn-outline"
			>Skip to content</a
		>
		<Header />
		<main id="main" class="pb-20 md:pb-0">
			<slot />
		</main>
		<Footer />

		<script is:inline>
			// Global click tracking. Lives here rather than on each link so a new
			// CTA anywhere on the site is tracked without extra wiring.
			;(function () {
				function track(event, params) {
					if (window.gtag) window.gtag('event', event, params || {})
				}
				document.addEventListener('click', function (e) {
					var tel = e.target.closest && e.target.closest('a[href^="tel:"]')
					if (tel) {
						track('phone_call_click', {
							link_text: (tel.textContent || '').trim(),
							location: tel.dataset.location || 'unknown',
						})
					}
					var el = e.target.closest && e.target.closest('[data-analytics]')
					if (el) track(el.dataset.analytics, {})
				})
				document.addEventListener(
					'toggle',
					function (e) {
						if (e.target.tagName === 'DETAILS' && e.target.open) {
							track('faq_expand', { question: (e.target.querySelector('summary') || {}).textContent })
						}
					},
					true,
				)
			})()
		</script>
		<MobileStickyCTA />
	</body>
</html>

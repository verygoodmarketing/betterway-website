---
import Layout from '../layouts/main.astro'
import FormRequestInspection from '../components/FormRequestInspection.astro'
import TrustBar from '../components/TrustBar.astro'
import Icon from '../components/Icon.astro'
import Testimonials from '../components/Testimonials.astro'
import { COMPANY, GUARANTEE, telHref, serviceAreaNames } from '../config/company'
import { breadcrumbSchema } from '../lib/schema'

const content = {
	title: `Request a Free Inspection | ${COMPANY.name}`,
	description: `Request a free pest, termite, mosquito, rodent, or brown recluse inspection anywhere in North Alabama. Call ${COMPANY.phoneFormatted}.`,
}

const schemas = [
	breadcrumbSchema([
		{ name: 'Home', path: '/' },
		{ name: 'Request Inspection', path: '/request-inspection' },
	]),
].filter(Boolean)
---

<Layout content={content} schemas={schemas}>
	{/*
	  No hero image on this page. It exists to be completed, and a decorative
	  header would push the form below the fold on a phone for no gain.
	*/}
	<section class="request-top">
		<div class="container request-split">
			<div class="request-pitch">
				<p class="eyebrow">Free inspection · No obligation</p>
				<h1>Let us come look at it.</h1>
				<p class="muted request-sub">
					We inspect before anyone quotes you a number, and we will tell you if you do not need us.
				</p>

				<a href={telHref()} data-location="request-hero" class="btn btn-cta btn-lg request-call">
					Call {COMPANY.phoneFormatted}
				</a>
				<p class="request-hours muted">
					{COMPANY.hoursDisplay.map(row => `${row.days}: ${row.hours}`).join(' · ')}
				</p>

				<ul class="request-points">
					{[
						'Free inspection — we look before we quote',
						'A straight answer, including if you do not need us',
						`${GUARANTEE.name} — satisfied or your money back`,
						`Serving ${serviceAreaNames()}`,
					].map(item => (
						<li>
							<span class="request-check"><Icon name="check" class="icon-sm" /></span>
							{item}
						</li>
					))}
				</ul>
			</div>

			<div class="request-form">
				<FormRequestInspection
					id="request-page-form"
					heading="Request your free inspection"
					sub="Name and phone is all we need. We call you back to set a time."
				/>
			</div>
		</div>
	</section>

	<TrustBar />
	<Testimonials featuredOnly limit={3} />
</Layout>

<style>
	.request-top { padding-block: clamp(1.75rem, 5vw, 3.5rem); }
	.request-split { display: grid; gap: 2rem; align-items: start; }
	.request-pitch { display: grid; gap: 0.75rem; justify-items: start; }
	.request-sub { font-size: var(--text-lg); max-width: 46ch; }
	.request-call { margin-top: 0.5rem; }
	.request-hours { font-size: var(--text-xs); }
	.request-points { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.625rem; }
	.request-points li {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		font-size: var(--text-sm);
		font-weight: 600;
	}
	.request-check { color: var(--color-brand-700); flex-shrink: 0; margin-top: 2px; }

	@media (min-width: 1024px) {
		.request-split { grid-template-columns: 1fr 1fr; gap: 3.5rem; }
	}
</style>

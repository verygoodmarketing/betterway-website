---
import Layout from '../layouts/main.astro'
import Hero from '../components/Hero.astro'
import TrustBar from '../components/TrustBar.astro'
import FormRequestInspection from '../components/FormRequestInspection.astro'
import ServiceCard from '../components/ServiceCard.astro'
import Testimonials from '../components/Testimonials.astro'
import ProcessStep from '../components/ProcessStep.astro'
import Differentiators from '../components/Differentiators.astro'
import CtaBand from '../components/CtaBand.astro'
import Icon from '../components/Icon.astro'
import {
	COMPANY,
	SERVICES,
	SERVICE_AREAS,
	PROCESS_STEPS,
	GUARANTEE,
	COUNTIES,
	telHref,
	servicePath,
	areaPath,
} from '../config/company'

const content = {
	title: `Pest Control in Hartselle & North Alabama | ${COMPANY.name}`,
	description: `Locally owned pest, termite, mosquito, rodent, and brown recluse control across North Alabama. Free inspections. Call ${COMPANY.phoneFormatted}.`,
}

const featured = SERVICES.filter(s => s.featured)
---

<Layout content={content}>
	<Hero
		eyebrow="Locally owned · Hartselle, Alabama"
		heading="Protecting Your Home and Family From Unwanted Pests"
		sub={`Family owned in ${COMPANY.address.locality}, serving ${COUNTIES.join(', ')} counties. Free inspections, honest quotes, and the ${GUARANTEE.name} behind every job.`}
		priority
	>
		<ul class="hero-services">
			{SERVICES.map(service => (
				<li>
					<a href={servicePath(service.slug)} class="hero-service">
						<Icon name={service.icon} class="icon-sm" />
						<span>{service.shortName}</span>
					</a>
				</li>
			))}
		</ul>
	</Hero>

	<TrustBar />

	{/*
	  The form sits immediately below the fold rather than halfway down the page.
	  Someone who scrolled past the hero without tapping call is the exact person
	  this needs to catch.
	*/}
	<section class="section" id="request-inspection">
		<div class="container lead-split">
			<div class="lead-pitch prose-block">
				<p class="eyebrow">Free inspection</p>
				<h2>Tell us what you are seeing.</h2>
				<p class="muted">
					We come look before anyone quotes you a number, and we will tell you if you do not need
					us. Most people call — that is usually fastest — but if it is after hours or you would
					rather not talk, the form gets you the same thing.
				</p>
				<a href={telHref()} data-location="lead-split" class="btn btn-cta btn-lg">
					Call {COMPANY.phoneFormatted}
				</a>
				<ul class="lead-points">
					{[
						'Free inspection, no obligation',
						'A real quote before any work starts',
						`${GUARANTEE.name} — satisfied or your money back`,
						'The same technicians on every visit',
					].map(point => (
						<li>
							<span class="lead-check"><Icon name="check" class="icon-sm" /></span>
							{point}
						</li>
					))}
				</ul>
			</div>
			<FormRequestInspection id="home-lead-form" />
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<div class="section-head">
				<h2>What we treat</h2>
				<p class="muted">Homes and businesses across North Alabama, all of it starting with a free inspection.</p>
			</div>
			<div class="card-grid">
				{featured.map(service => (
					<ServiceCard
						href={servicePath(service.slug)}
						title={service.name}
						description={service.excerpt}
						icon={service.icon}
						chips={service.chips}
					/>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<h2>How it works</h2>
				<p class="muted">Four steps, no surprises.</p>
			</div>
			<div class="steps-grid">
				{PROCESS_STEPS.map((step, i) => (
					<ProcessStep number={i + 1} title={step.title} description={step.description} />
				))}
			</div>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<div class="section-head">
				<h2>Why people stay with us</h2>
			</div>
			<Differentiators />
		</div>
	</section>

	<Testimonials featuredOnly limit={3} alt={false} sub="Real reviews from Hartselle, Moulton, and around North Alabama." />

	<section class="section section-alt">
		<div class="container">
			<div class="section-head">
				<h2>Where we work</h2>
				<p class="muted">
					We reach {COUNTIES.join(', ')} counties from our office in {COMPANY.address.locality}.
				</p>
			</div>
			<ul class="area-links">
				{SERVICE_AREAS.map(area => (
					<li>
						<a href={areaPath(area.slug)} class="area-link">
							<span class="area-link-name">Pest Control {area.name}, AL</span>
							<span class="muted area-link-county">{area.county} County</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<CtaBand location="home-footer" />
</Layout>

<style>
	.hero-services {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		list-style: none;
		margin: 0.5rem 0 0;
		padding: 0;
	}
	.hero-service {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 40px;
		padding: 0.5rem 0.875rem;
		border-radius: 999px;
		border: 1px solid rgb(255 255 255 / 0.35);
		background: rgb(255 255 255 / 0.1);
		color: #fff;
		font-size: var(--text-xs);
		font-weight: 700;
		text-decoration: none;
	}
	.hero-service:hover { background: rgb(255 255 255 / 0.2); }

	.lead-split { display: grid; gap: 2rem; align-items: start; }
	.lead-pitch { max-width: 52ch; }
	.lead-points { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 0.625rem; }
	.lead-points li {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		font-size: var(--text-sm);
		font-weight: 600;
	}
	.lead-check { color: var(--color-brand-700); flex-shrink: 0; margin-top: 2px; }

	.section-head { display: grid; gap: 0.5rem; margin-bottom: 1.75rem; max-width: 60ch; }
	.card-grid { display: grid; gap: 1rem; }
	.steps-grid { display: grid; gap: 1.75rem; }

	.area-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.625rem; }
	.area-link {
		display: grid;
		gap: 0.125rem;
		min-height: var(--tap);
		padding: 0.875rem 1rem;
		background: #fff;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-btn);
		text-decoration: none;
	}
	.area-link:hover { border-color: var(--color-brand-600); }
	.area-link-name { font-weight: 700; font-size: var(--text-sm); }
	.area-link-county { font-size: var(--text-xs); }

	@media (min-width: 640px) {
		.card-grid { grid-template-columns: repeat(2, 1fr); }
		.steps-grid { grid-template-columns: repeat(2, 1fr); }
		.area-links { grid-template-columns: repeat(2, 1fr); }
	}
	@media (min-width: 1024px) {
		.lead-split { grid-template-columns: 1.1fr 1fr; gap: 3.5rem; }
		.card-grid { grid-template-columns: repeat(3, 1fr); }
		.steps-grid { grid-template-columns: repeat(4, 1fr); }
		.area-links { grid-template-columns: repeat(3, 1fr); }
	}
</style>

---
import Layout from '../layouts/main.astro'
import FormRequestInspection from '../components/FormRequestInspection.astro'
import ServiceCard from '../components/ServiceCard.astro'
import ServiceIcon from '../components/ServiceIcon.astro'
import Testimonials from '../components/Testimonials.astro'
import TrustBadge from '../components/TrustBadge.astro'
import ProcessStep from '../components/ProcessStep.astro'
import CtaBand from '../components/CtaBand.astro'
import {
	COMPANY,
	SERVICES,
	SERVICE_AREAS,
	DIFFERENTIATORS,
	PROCESS_STEPS,
	COUNTIES,
	telHref,
	servicePath,
	areaPath,
} from '../config/company'

const content = {
	title: `Pest Control in Hartselle & North Alabama | ${COMPANY.name}`,
	description: `Locally owned pest, termite, mosquito, rodent, and brown recluse control across North Alabama. Free inspections. Call ${COMPANY.phoneFormatted}.`,
}

const featured = SERVICES.filter(s => s.featured)
---

<Layout content={content}>
	<section class="relative min-h-[600px] flex items-center">
		<div class="absolute inset-0 -z-10">
			<img
				src="/bg-house.jpg"
				alt=""
				class="h-full w-full object-cover"
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
			<div class="absolute inset-0 bg-black/40"></div>
		</div>
		<div class="container w-full py-16 md:py-24">
			<div class="max-w-4xl mx-auto text-center space-y-8 text-white">
				<img
					src="/logo.png"
					alt={COMPANY.name}
					width="520"
					height="140"
					class="h-32 w-auto mx-auto drop-shadow-lg sm:h-64 mb-16"
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
				<h1 class="text-4xl md:text-5xl font-extrabold drop-shadow-lg">
					Protecting Your Home and Family From Unwanted Pests
				</h1>
				<p class="text-lg md:text-xl max-w-2xl mx-auto drop-shadow">
					{COMPANY.name} is locally owned and operated in {COMPANY.address.locality}, Alabama. We
					service a large area of North Alabama which includes {COUNTIES.join(', ')} Counties.
				</p>
				<div class="flex flex-wrap justify-center gap-4">
					<a href={telHref()} data-location="hero" class="btn btn-primary text-base px-8 py-3 shadow-lg">
						Call {COMPANY.phoneFormatted}
					</a>
					<a
						href="#request-inspection"
						class="btn bg-white/10 backdrop-blur border-2 border-white text-white hover:bg-white/20 px-8 py-3 shadow-lg"
						>Request Free Inspection</a
					>
				</div>

				<div class="pt-8 border-t border-white/20">
					<p class="text-sm font-medium mb-4 uppercase tracking-wider">Our Services</p>
					<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
						{SERVICES.map(service => (
							<ServiceIcon href={servicePath(service.slug)} label={service.shortName} />
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-gray-50 py-12">
		<div class="container">
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
				{DIFFERENTIATORS.map(item => (
					<TrustBadge title={item.title} description={item.text} icon={item.icon} />
				))}
			</div>
		</div>
	</section>

	<section id="request-inspection" class="container py-12">
		<div class="max-w-md mx-auto">
			<div class="text-center mb-6">
				<h2>Request a Free Inspection</h2>
				<p class="text-muted-foreground">
					Tell us what you're seeing and we'll come look. No charge, no pressure.
				</p>
			</div>
			<FormRequestInspection id="home-lead-form" />
		</div>
	</section>

	<section class="bg-gray-50 py-12">
		<div class="container">
			<div class="max-w-4xl mx-auto">
				<h2 class="text-center mb-12">How We Protect Your Home</h2>
				<div class="grid md:grid-cols-2 gap-8">
					{PROCESS_STEPS.map((step, i) => (
						<ProcessStep number={i + 1} title={step.title} description={step.description} />
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="container py-12 grid gap-6">
		<h2>Residential &amp; Commercial Services</h2>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{featured.map(service => (
				<ServiceCard
					href={servicePath(service.slug)}
					title={service.name}
					description={service.excerpt}
					icon={service.icon}
					chips={service.chips}
				/>
			))}
		</div>
	</section>

	<Testimonials featuredOnly limit={3} />

	<section class="container py-12 grid gap-6">
		<div class="max-w-3xl space-y-3">
			<h2>Where We Work</h2>
			<p class="text-muted-foreground">
				We reach several counties in North Alabama — {COUNTIES.join(', ')} — from our office in
				{' '}{COMPANY.address.locality}.
			</p>
		</div>
		<ul class="flex flex-wrap gap-3">
			{SERVICE_AREAS.map(area => (
				<li>
					<a href={areaPath(area.slug)} class="btn btn-outline text-sm px-4 py-2">{area.name}, AL</a>
				</li>
			))}
		</ul>
	</section>

	<CtaBand location="home-footer" />
</Layout>

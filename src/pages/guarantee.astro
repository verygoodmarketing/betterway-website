---
import Layout from '../layouts/main.astro'
import Hero from '../components/Hero.astro'
import TrustBar from '../components/TrustBar.astro'
import Icon from '../components/Icon.astro'
import CtaBand from '../components/CtaBand.astro'
import { COMPANY, GUARANTEE, SERVICES, telHref, servicePath } from '../config/company'
import { breadcrumbSchema } from '../lib/schema'

const content = {
	title: `${GUARANTEE.name} | ${COMPANY.name}`,
	description: `${GUARANTEE.promise} It covers every service we provide. Call ${COMPANY.phoneFormatted}.`,
}

const schemas = [
	breadcrumbSchema([
		{ name: 'Home', path: '/' },
		{ name: 'Guarantee', path: '/guarantee' },
	]),
].filter(Boolean)
---

<Layout content={content} schemas={schemas}>
	<Hero
		eyebrow="Our promise"
		heading={`The ${GUARANTEE.name}`}
		sub={GUARANTEE.promise}
		compact
	/>
	<TrustBar />

	<section class="section">
		<div class="container guarantee-split">
			<div class="prose-block guarantee-copy">
				<p>That is the whole policy. There is no version of it with a page of conditions attached.</p>
				<p>
					We aim to give you better service and better results, and the guarantee is how we stand
					behind that. It applies to every service we provide — pest control, termite, mosquito,
					rodent, and brown recluse work alike.
				</p>
				<p>
					If something is not right, call us before you do anything else. Most of the time it is
					something we can come back out and fix. If it is not, you get your money back.
				</p>
			</div>

			<aside class="guarantee-aside card">
				<h2 class="aside-title">Covered services</h2>
				<ul class="covered-list">
					{SERVICES.map(service => (
						<li>
							<span class="covered-check"><Icon name="check" class="icon-sm" /></span>
							<a href={servicePath(service.slug)}>{service.name}</a>
						</li>
					))}
				</ul>
				<a href={telHref()} data-location="guarantee" class="btn btn-cta btn-lg btn-block">
					Call {COMPANY.phoneFormatted}
				</a>
			</aside>
		</div>
	</section>

	<CtaBand location="guarantee-footer" />
</Layout>

<style>
	.guarantee-split { display: grid; gap: 2rem; align-items: start; }
	.guarantee-copy { max-width: 60ch; }
	.guarantee-aside { display: grid; gap: 1rem; }
	.aside-title { font-size: var(--text-lg); }
	.covered-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
	.covered-list li { display: flex; align-items: center; gap: 0.5rem; font-size: var(--text-sm); min-height: 36px; }
	.covered-list a { font-weight: 600; text-decoration: none; }
	.covered-list a:hover { color: var(--color-brand-700); }
	.covered-check { color: var(--color-brand-700); flex-shrink: 0; }

	@media (min-width: 1024px) {
		.guarantee-split { grid-template-columns: 1.4fr 1fr; gap: 3rem; }
		.guarantee-aside { position: sticky; top: 92px; }
	}
</style>

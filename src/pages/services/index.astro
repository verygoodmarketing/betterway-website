---
import Layout from '../../layouts/main.astro'
import Hero from '../../components/Hero.astro'
import TrustBar from '../../components/TrustBar.astro'
import ServiceCard from '../../components/ServiceCard.astro'
import CtaBand from '../../components/CtaBand.astro'
import { COMPANY, SERVICES, COUNTIES, servicePath } from '../../config/company'
import { breadcrumbSchema } from '../../lib/schema'

const content = {
	title: `Pest Control Services | ${COMPANY.name}`,
	description: `Pest control, termite, mosquito, rodent, and brown recluse services for North Alabama homes and businesses. Free inspections. Call ${COMPANY.phoneFormatted}.`,
}

const schemas = [
	breadcrumbSchema([
		{ name: 'Home', path: '/' },
		{ name: 'Services', path: '/services' },
	]),
].filter(Boolean)
---

<Layout content={content} schemas={schemas}>
	<Hero
		eyebrow="Free inspection on every service"
		heading="Our Services"
		sub={`Year-round protection for homes and businesses across ${COUNTIES.join(', ')} counties.`}
		compact
	/>
	<TrustBar />

	<section class="section">
		<div class="container">
			<div class="card-grid">
				{SERVICES.map(service => (
					<ServiceCard
						href={servicePath(service.slug)}
						title={service.name}
						description={service.excerpt}
						icon={service.icon}
						chips={service.chips}
					/>
				))}
			</div>
		</div>
	</section>

	<CtaBand location="services-footer" />
</Layout>

<style>
	.card-grid { display: grid; gap: 1rem; }
	@media (min-width: 640px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (min-width: 1024px) { .card-grid { grid-template-columns: repeat(3, 1fr); } }
</style>

---
import Layout from '../../layouts/main.astro'
import Hero from '../../components/Hero.astro'
import TrustBar from '../../components/TrustBar.astro'
import Icon from '../../components/Icon.astro'
import Faqs from '../../components/Faqs.astro'
import CtaBand from '../../components/CtaBand.astro'
import Testimonials from '../../components/Testimonials.astro'
import FormRequestInspection from '../../components/FormRequestInspection.astro'
import {
	SERVICES,
	SERVICE_AREAS,
	COMPANY,
	GUARANTEE,
	telHref,
	areaPath,
	servicePath,
} from '../../config/company'
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../lib/schema'

export function getStaticPaths() {
	return SERVICES.map(service => ({
		params: { slug: service.slug },
		props: { service },
	}))
}

const { service } = Astro.props

const content = {
	title: `${service.metaTitle} | ${COMPANY.name}`,
	description: service.metaDescription,
}

const schemas = [
	serviceSchema(service),
	faqSchema(service.faqs),
	breadcrumbSchema([
		{ name: 'Home', path: '/' },
		{ name: 'Services', path: '/services' },
		{ name: service.name, path: servicePath(service.slug) },
	]),
].filter(Boolean)

const otherServices = SERVICES.filter(s => s.slug !== service.slug)
---

<Layout content={content} schemas={schemas}>
	<Hero eyebrow="Free inspection" heading={service.name} sub={service.excerpt} compact>
		<ul class="chips">
			{service.chips.map(chip => <li>{chip}</li>)}
		</ul>
	</Hero>
	<TrustBar />

	<nav aria-label="Breadcrumb" class="crumbs">
		<div class="container">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			<a href="/services">Services</a>
			<span aria-hidden="true">/</span>
			<span>{service.shortName}</span>
		</div>
	</nav>

	<section class="section">
		<div class="container service-split">
			<div class="service-main">
				<div class="prose-block">
					{service.body.map(paragraph => <p>{paragraph}</p>)}
				</div>

				<div class="included card">
					<h2 class="included-title">What is included</h2>
					<ul class="included-list">
						{service.features.map(feature => (
							<li>
								<span class="included-check"><Icon name="check" class="icon-sm" /></span>
								{feature}
							</li>
						))}
					</ul>
				</div>

				<div class="areas-inline">
					<h2 class="areas-title">{service.shortName} across North Alabama</h2>
					<p class="muted areas-sub">We provide {service.name.toLowerCase()} in each of these towns:</p>
					<ul class="area-chips">
						{SERVICE_AREAS.map(area => (
							<li><a href={areaPath(area.slug)}>{area.name}, AL</a></li>
						))}
					</ul>
				</div>
			</div>

			<aside class="service-aside" id="request-inspection">
				<FormRequestInspection
					id={`service-${service.slug}-form`}
					defaultService={service.slug}
					heading={`Free ${service.shortName} Inspection`}
					sub="Two required fields. We call you back to set a time."
				/>
				<div class="aside-call card">
					<p class="aside-call-label muted">Faster: just call us</p>
					<a href={telHref()} data-location="service-aside" class="btn btn-cta btn-lg btn-block">
						{COMPANY.phoneFormatted}
					</a>
					<p class="aside-hours muted">
						{COMPANY.hoursDisplay.map(row => `${row.days}: ${row.hours}`).join(' · ')}
					</p>
					<p class="aside-guarantee">{GUARANTEE.name}</p>
				</div>
			</aside>
		</div>
	</section>

	<Faqs faqs={service.faqs} heading={`${service.shortName} — common questions`} />

	<Testimonials limit={3} />

	<section class="section">
		<div class="container">
			<h2 class="other-title">Other services</h2>
			<ul class="other-list">
				{otherServices.map(other => (
					<li>
						<a href={servicePath(other.slug)} class="other-link">
							<span class="other-icon"><Icon name={other.icon} class="icon-sm" /></span>
							{other.name}
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<CtaBand
		heading={`Ready to deal with it?`}
		sub={`Free ${service.shortName.toLowerCase()} inspection, a real quote before any work starts, and a guarantee behind it.`}
		location="service-footer"
	/>
</Layout>

<style>
	.chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
	}
	.chips li {
		font-size: var(--text-xs);
		font-weight: 700;
		padding: 0.375rem 0.75rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.12);
		border: 1px solid rgb(255 255 255 / 0.3);
	}

	.crumbs {
		border-bottom: 1px solid var(--color-line);
		font-size: var(--text-xs);
		padding-block: 0.75rem;
	}
	.crumbs .container { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
	.crumbs a { color: var(--color-ink-muted); text-decoration: none; }
	.crumbs a:hover { color: var(--color-brand-700); }

	.service-split { display: grid; gap: 2rem; align-items: start; }
	.service-main { display: grid; gap: 2rem; }

	.included-title { font-size: var(--text-lg); margin-bottom: 0.875rem; }
	.included-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.625rem; }
	.included-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		font-size: var(--text-sm);
		line-height: 1.55;
	}
	.included-check { color: var(--color-brand-700); flex-shrink: 0; margin-top: 3px; }

	.areas-title { font-size: var(--text-lg); }
	.areas-sub { font-size: var(--text-sm); margin-top: 0.25rem; }
	.area-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0.875rem 0 0;
		padding: 0;
	}
	.area-chips a {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0.5rem 0.875rem;
		border-radius: 999px;
		border: 1px solid var(--color-line);
		font-size: var(--text-xs);
		font-weight: 700;
		text-decoration: none;
	}
	.area-chips a:hover { border-color: var(--color-brand-600); background: var(--color-brand-50); }

	.service-aside { display: grid; gap: 1rem; }
	.aside-call { display: grid; gap: 0.625rem; text-align: center; }
	.aside-call-label { font-size: var(--text-sm); font-weight: 600; }
	.aside-hours { font-size: var(--text-xs); }
	.aside-guarantee { font-size: var(--text-xs); font-weight: 700; color: var(--color-brand-700); }

	.other-title { font-size: var(--text-xl); margin-bottom: 1rem; }
	.other-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
	.other-link {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		min-height: var(--tap);
		padding: 0.75rem 1rem;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-btn);
		font-size: var(--text-sm);
		font-weight: 700;
		text-decoration: none;
	}
	.other-link:hover { border-color: var(--color-brand-600); background: var(--color-brand-50); }
	.other-icon { color: var(--color-brand-700); }

	@media (min-width: 640px) {
		.other-list { grid-template-columns: repeat(2, 1fr); }
	}
	@media (min-width: 1024px) {
		.service-split { grid-template-columns: 1.5fr 1fr; gap: 3rem; }
		.service-aside { position: sticky; top: 92px; }
		.other-list { grid-template-columns: repeat(4, 1fr); }
	}
</style>

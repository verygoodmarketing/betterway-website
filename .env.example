# Lead submission provider
# Supported values: formspree | highlevel
# Default is formspree if LEAD_PROVIDER is unset.
LEAD_PROVIDER=formspree

# -------------------------------------------------------------------
# Formspree (current default)
# -------------------------------------------------------------------
# Example: https://formspree.io/f/abcde123
FORMSPREE_ENDPOINT=

# -------------------------------------------------------------------
# HighLevel (future option)
# -------------------------------------------------------------------
HIGHLEVEL_API_KEY=
HIGHLEVEL_LOCATION_ID=
# Optional override. Leave blank to use default in code.
HIGHLEVEL_ENDPOINT=

# Optional analytics
PUBLIC_GA_ID=
